rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Comprobantes de pago — solo el usuario autenticado puede subir
    match /comprobantes/{filename} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Imágenes de productos — solo admin puede subir/eliminar
    match /productos/{filename} {
      allow read:  if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.esAdmin == true;
    }
  }
}
